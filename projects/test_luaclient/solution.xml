<?xml version="1.0" encoding="utf-8"?>
<!-- luaclient 代码生成测试项目。
     验证 Gen 用 Scriban 模板生成 Lua 客户端代码（ZezeMeta / Module / ModuleMeta / message / handler）。
     运行：在此目录执行 gen.bat（或 dotnet ..\bin\Release\net10.0\Gen.dll）。 -->
<solution name="luatest" ModuleIdAllowRanges="1-3,5">

	<bean name="Bean1">
		<enum name="Enum1" value="4"/>
		<variable id="1" name="v1" type="int" default="1"/>
		<variable id="2" name="v2" type="map" key="int" value="int"/>
	</bean>

	<module name="Module1" id="1">
		<enum name="eTestEnum" value="1"/>

		<beankey name="AutoKey">
			<variable id="1" name="name" type="string"/>
			<variable id="2" name="localId" type="long"/>
		</beankey>

		<bean name="Simple" TypeId="1">
			<variable id="1" name="int1" type="int"/>
			<variable id="2" name="long2" type="long"/>
			<variable id="3" name="string3" type="string"/>
		</bean>

		<!-- 覆盖「变量类型直接是 bean」的场景：ref 的 variable_type 是 Bean，模板据此（is_bean）走
		     build_index/build_newindex/__reg_beans 分支。ScriptModelBuilder 重构曾在此回归
		     （case Bean 壳漏 is_bean，丢失 __newindex 和 __reg_beans）。 -->
		<bean name="BeanVar">
			<variable id="1" name="ref" type="Simple"/>
		</bean>

		<bean name="Value">
			<enum name="Enum1" value="4"/>
			<variable id="1" name="int1" type="int" AllowNegative="true"/>
			<variable id="2" name="long2" type="long"/>
			<variable id="3" name="string3" type="string"/>
			<variable id="4" name="bool4" type="bool"/>
			<variable id="5" name="short5" type="short"/>
			<variable id="6" name="float6" type="float"/>
			<variable id="7" name="double7" type="double"/>
			<variable id="9" name="list9" type="list[luatest.Bean1]"/>
			<variable id="10" name="set10" type="set[int]"/>
			<variable id="11" name="map11" type="map[long,Simple]"/>
			<variable id="14" name="dynamic14" type="dynamic">
				<value bean="luatest.Bean1:1"/>
				<value bean="Simple:2"/>
			</variable>
			<variable id="17" name="vector2" type="vector2"/>
			<variable id="19" name="vector3" type="vector3"/>
		</bean>

		<beankey name="Key">
			<enum name="Enum1" value="4"/>
			<variable id="1" default="1" name="s" type="short"/>
		</beankey>

		<protocol name="Protocol1" argument="Value" handle="server,clientscript"/>
		<rpc name="Rpc1" argument="Value" result="Value" handle="server,clientscript"/>

		<module name="Module11" id="3">
			<bean name="Base" extendable="true">
				<variable id="1" name="baseInt" type="int"/>
			</bean>
			<bean name="Dynamic">
				<variable id="1" name="dyn" type="dynamic:Base">
					<value bean="Base:1"/>
				</variable>
			</bean>
		</module>
	</module>

	<project name="luatest" GenDir="gen" SrcDir="src" platform="luaclient" IncludeAllModules="true">
		<!-- service 提供 HandleFlags，决定哪些协议生成客户端 handler；module ref 让 SetModuleReference 设置 ReferenceService -->
		<service name="ClientService" handle="clientscript">
			<module ref="luatest.Module1"/>
		</service>
	</project>
</solution>
